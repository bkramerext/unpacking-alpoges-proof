% Central quantitative contradiction, not a generic proof flowchart.
% The right plot is the ratio of two scales, not the actual value of A_k.
\begin{tikzpicture}[x=.85cm,y=.82cm,>=Latex,every node/.style={font=\footnotesize}]
\node[anchor=west,font=\footnotesize\bfseries] at (.35,8.55) {Arithmetic input on arbitrarily late windows};
\node[anchor=west,text=black!75,font=\scriptsize] at (.35,8.02) {Theta evaluations, periods, lattice slopes, cohomological windows, character averaging};
\draw[accent!50,line width=.8pt] (.35,7.67)--(13.65,7.67);
\node[align=center,fill=blue!5,draw=accent!45,inner sep=6pt,rounded corners=2pt,text width=11.8cm] at (7.0,6.93)
 {$\displaystyle H_\psi(x)\le x^{1/2+9\varepsilon}$\quad for $Y\le x\le Y^{3/2}$, with one fixed positive family};
\node[anchor=west,font=\footnotesize\bfseries] at (.35,5.93) {Hypothetical pole to the right of $\theta$};
\node[anchor=west,font=\footnotesize\bfseries] at (7.35,5.93) {Comparison of derivative scales};
% geometric pole sketch
\draw[->,black!70] (.9,2.12)--(6.3,2.12);
\node[font=\scriptsize,anchor=west] at (6.33,2.23) {$\Re(s)$};
\draw[->,black!70] (.9,2.0)--(.9,5.25);
\node[font=\scriptsize,anchor=east] at (.78,5.12) {$\Im(s)$};
\draw[black!40,dashed] (1.94,2.12)--(1.94,5.36);
\draw[accent!70,dashed] (2.74,2.12)--(2.74,5.36);
\draw[accent!70] (5.65,2.12)--(5.65,5.33);
\filldraw[red!70!black] (3.86,3.78) circle (2.05pt);
\filldraw[accent] (5.65,3.96) circle (2.05pt);
\draw[<->,black!65,line width=.85pt] (3.92,4.01)--(5.59,4.18);
\node[font=\scriptsize,fill=white,inner sep=1.4pt] at (4.77,4.28) {$d$};
\node[font=\scriptsize,anchor=east] at (3.77,3.74) {$\rho$};
\node[font=\scriptsize,anchor=west] at (5.72,3.88) {$z$};
\node[below,font=\scriptsize] at (1.94,2.11) {$\frac12$};
\node[below,font=\scriptsize] at (2.74,2.11) {$\theta$};
\node[below,font=\scriptsize] at (3.86,2.11) {$\beta$};
\node[below,font=\scriptsize] at (5.65,2.11) {$\sigma$};
\draw[<->,accent!75] (2.76,1.39)--(5.64,1.39);
\node[fill=white,inner sep=1.8pt,font=\scriptsize] at (4.19,1.39) {$\sigma-\theta$};
\node[font=\scriptsize,anchor=west] at (1.25,.63) {$\theta<\beta$ and, after isolation, $d<\sigma-\theta$};
% ratio plot
\draw[->,black!75] (7.68,2.06)--(13.64,2.06) node[right,font=\scriptsize] {$k$};
\draw[->,black!75] (7.68,2.06)--(7.68,5.47);
\draw[densely dashed,gray!70] (7.7,2.82)--(13.53,2.82);
\node[font=\scriptsize,anchor=east] at (7.59,2.82) {$0$};
\node[font=\scriptsize,align=left,anchor=west] at (8.06,5.35) {$\log\!\left(\dfrac{\text{pole scale}}{\text{ceiling}}\right)$};
\draw[accent,line width=1.2pt] (8.05,2.24)--(13.11,4.76);
\foreach \x/\y in {8.85/2.64,9.85/3.14,11.1/3.77,12.25/4.34} {
  \filldraw[fill=accent,draw=white,line width=.4pt] (\x,\y) circle (2.0pt);
}
\node[font=\scriptsize,text=accent,align=left,anchor=west] at (10.43,3.08) {positive slope\\$\log((\sigma-\theta)/d)$};
\node[font=\scriptsize,anchor=west] at (8.0,1.51) {Dots: orders selected by successive windows};
\draw[black!35] (.35,.36)--(13.7,.36);
\end{tikzpicture}
